<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.appregistros.proyectohibernate.controller.LibroController"
            prefWidth="700.0" prefHeight="500.0">

    <VBox spacing="12.0"
          AnchorPane.topAnchor="20.0"
          AnchorPane.leftAnchor="20.0"
          AnchorPane.rightAnchor="20.0"
          AnchorPane.bottomAnchor="20.0">

        <Label text="Registro de libros"
               style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

        <TextField fx:id="txtTitulo"
                   promptText="Título del libro"/>

        <TextField fx:id="txtAutor"
                   promptText="Autor"/>

        <HBox spacing="10.0">
            <TextField fx:id="txtAnio"
                       promptText="Año de publicación"/>
            <TextField fx:id="txtPrecio"
                       promptText="Precio"/>
        </HBox>

        <HBox spacing="10.0">
            <Button text="Guardar libro"
                    onAction="#guardarLibro"/>
            <Button text="Limpiar"
                    onAction="#limpiarCampos"/>
        </HBox>

        <Label text="Libros registrados"
               style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

        <TableView fx:id="tablaLibros"
                   VBox.vgrow="ALWAYS">

            <columns>
                <TableColumn fx:id="colId"
                             text="ID"
                             prefWidth="60.0"/>

                <TableColumn fx:id="colTitulo"
                             text="Título"
                             prefWidth="170.0"/>

                <TableColumn fx:id="colAutor"
                             text="Autor"
                             prefWidth="150.0"/>

                <TableColumn fx:id="colAnio"
                             text="Año"
                             prefWidth="100.0"/>

                <TableColumn fx:id="colPrecio"
                             text="Precio"
                             prefWidth="100.0"/>
            </columns>

        </TableView>

    </VBox>

</AnchorPane>
