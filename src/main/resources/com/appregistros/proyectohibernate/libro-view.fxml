<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.appregistros.proyectohibernate.controller.LibroController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Gestión de libros - Hibernate ORM">
        <font>
            <Font name="System Bold" size="18.0"/>
        </font>
    </Label>

    <HBox spacing="10.0">
        <Button text="Ir a categorías" onAction="#irACategorias"/>
    </HBox>

    <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints minWidth="130.0" prefWidth="150.0"/>
            <ColumnConstraints hgrow="ALWAYS" prefWidth="400.0"/>
        </columnConstraints>

        <Label text="Título:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtTitulo" promptText="Título del libro"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Autor:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtAutor" promptText="Autor del libro"
                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Año de publicación:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="txtAnio" promptText="Año de publicación"
                   GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Precio:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="txtPrecio" promptText="Precio del libro"
                   GridPane.columnIndex="1" GridPane.rowIndex="3"/>
    </GridPane>

    <HBox spacing="10.0">
        <Button fx:id="btnGuardar" text="Guardar libro" onAction="#guardarLibro"/>
        <Button fx:id="btnModificar" text="Modificar libro" onAction="#modificarLibro" disable="true"/>
        <Button fx:id="btnEliminar" text="Eliminar libro" onAction="#eliminarLibro" disable="true"/>
        <Button fx:id="btnCargar" text="Cargar libros" onAction="#cargarLibros"/>
        <Button fx:id="btnLimpiar" text="Limpiar campos" onAction="#limpiarCampos"/>
    </HBox>

    <Label text="Seleccione un libro de la tabla para modificarlo o eliminarlo."/>

    <TableView fx:id="tablaLibros" prefHeight="300.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60.0"/>
            <TableColumn fx:id="colTitulo" text="Título" prefWidth="260.0"/>
            <TableColumn fx:id="colAutor" text="Autor" prefWidth="200.0"/>
            <TableColumn fx:id="colAnio" text="Año" prefWidth="80.0"/>
            <TableColumn fx:id="colPrecio" text="Precio" prefWidth="100.0"/>
        </columns>

        <placeholder>
            <Label text="Tabla sin contenido"/>
        </placeholder>
    </TableView>

</VBox>
